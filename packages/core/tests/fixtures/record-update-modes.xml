<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <fullName>Record_Update_Modes</fullName>
    <label>Record Update Modes</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <recordUpdates>
        <name>Update_By_Reference</name>
        <label>Update By Reference</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_By_Criteria</targetReference>
        </connector>
        <inputReference>$Record</inputReference>
        <inputAssignments>
            <field>Returning_Participant__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
    </recordUpdates>
    <recordUpdates>
        <name>Update_By_Criteria</name>
        <label>Update By Criteria</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Ref_Only</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ContactId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Open</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Ref_Only</name>
        <label>Update Ref Only</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>varRec_Account</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_By_Reference</targetReference>
        </connector>
        <object>ProgramEnrollment</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <formulas>
        <name>forTxt_FullName</name>
        <dataType>String</dataType>
        <expression>$Record.First_Name__c &amp; " " &amp; $Record.Last_Name__c</expression>
    </formulas>
    <textTemplates>
        <name>txtTxt_Body</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Hello {!forTxt_FullName}</text>
    </textTemplates>
    <constants>
        <name>conTxt_Status</name>
        <dataType>String</dataType>
        <value>
            <stringValue>In Progress</stringValue>
        </value>
    </constants>
</Flow>
