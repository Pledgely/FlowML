{
  "name": "flowml",
  "version": "1.0.0",
  "description": "FlowML - Salesforce Flow YAML Transpiler",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
